# Overgod for GFOS: 68040, libnix, soft float, Allegro 4 from gfopenallegro
# (allegro4.library on acgame.library), both in the drawer's Libs/
# (package/build-amiga.sh builds them at the commits it pins).
#   make -f amiga/Makefile.amigaos PREFIX=<stove>/prefix A4=<gfopenallegro/allegro4> A4OUT=.. ACGOUT=..
PREFIX ?= $(HOME)/AmiCradle/kitchen/stoves/os32-gcc16-open6/prefix
A4 ?= ../gfopenallegro/allegro4
A4OUT ?= $(A4)/build-amiga
ACGOUT ?= ../acgame/build-amiga
CC = $(PREFIX)/bin/m68k-amigaos-gcc
STRIP = $(PREFIX)/bin/m68k-amigaos-strip
NAME = Overgod
BUILD ?= build/amigaos
DIR = $(BUILD)/$(NAME)

SRCS = actor.c bullet.c cloud.c cmds.c displ_in.c display.c eclass.c enemy.c game.c input.c levels.c light.c main.c menu.c palette.c pickup.c score.c sound.c stuff.c tile.c  amiga/amiga_start.c
OBJS = $(patsubst %.c,$(BUILD)/obj/%.o,$(SRCS))

SOFT = -specs=$(A4)/specs/m68k-soft-m68040.specs
# upstream's xpart()/ypart() are gnu89 'inline' (stuff.c holds the bodies)
CFLAGS = -noixemul -m68040 $(SOFT) -O2 -fomit-frame-pointer -fno-tree-loop-distribute-patterns \
	-fcommon -fgnu89-inline -w -I. -I$(A4)/include -D__amigaos__
LIBS = $(A4OUT)/liballeg.a -lm

all: $(DIR)/$(NAME) package

$(BUILD)/$(NAME).debug: $(OBJS)
	$(CC) -noixemul -m68040 $(SOFT) -o $@ $(OBJS) $(LIBS)

$(DIR)/$(NAME): $(BUILD)/$(NAME).debug
	@mkdir -p $(DIR)
	$(STRIP) -o $@ $<

$(BUILD)/obj/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c -o $@ $<

# The drawer: the game, gfx/, wavs/, the default overgod.cfg, Libs/ with
# allegro4.library and acgame.library, the read-mes and the icons.
package: $(DIR)/$(NAME)
	mkdir -p $(DIR)/Libs
	rm -rf $(DIR)/gfx $(DIR)/wavs && cp -R gfx wavs $(DIR)/
	cp overgod.cfg $(DIR)/
	cp $(A4OUT)/allegro4.library $(ACGOUT)/acgame.library $(DIR)/Libs/
	cp amiga/AMIGA_PORT.md $(DIR)/ReadMe
	cp readme.txt $(DIR)/ReadMe-Overgod
	cp licence.txt $(DIR)/COPYING.txt
	cp amiga/icons/$(NAME).info amiga/icons/ReadMe.info $(DIR)/
	for f in ReadMe-Overgod COPYING.txt; do cp amiga/icons/ReadMe.info $(DIR)/$$f.info; done
	cp amiga/icons/$(NAME)-drawer.info $(BUILD)/$(NAME).info
	cp amiga/Install-$(NAME) amiga/Install-$(NAME).info $(BUILD)/

clean:
	rm -rf $(BUILD)
.PHONY: all package clean
